# Copy this file to ".env" and fill in your own values. Never share your real .env file.

# Your bot's token from https://discord.com/developers/applications
# This must be a DIFFERENT bot application than your other bot — create a new
# application in the Developer Portal for this one.
DISCORD_TOKEN=your_bot_token_here

# The command prefix people type before the command
PREFIX=!

# The voice channel ID(s) that count as "recording sessions".
# Separate multiple channel IDs with commas, e.g. 1213894066518098003,1216157626749161492
# Right-click a voice channel (with Developer Mode on) > Copy Channel ID.
TRACKED_VC_IDS=

# The role ID(s) for your Recording Crew roles — you can list all 3 here.
# Separate multiple role IDs with commas, e.g. 111111111,222222222,333333333
TRACKED_ROLE_ID=

# Only members with one of these role IDs can run !inactivity / !lastseen / !merge / !removeunverified.
# Separate multiple role IDs with commas. If left blank, anyone with "Manage Roles" can use it.
ALLOWED_ROLE_ID=

# The role ID for your "Unverified" role. Used by !removeunverified — it gets
# removed from anyone who has a role you specify as counting as verified.
UNVERIFIED_ROLE_ID=

# --- Automatic Unverified removal (no command needed — runs on its own schedule) ---

# Role ID(s) that count as "verified". Anyone with one of these AND Unverified will
# automatically have Unverified removed, checked on the interval below.
# Separate multiple role IDs with commas.
AUTO_VERIFIED_ROLE_ID=

# The channel ID where the bot posts a log message each time it runs this check
# (only posts something if it actually removed the role from someone).
# Right-click the channel (Developer Mode on) > Copy Channel ID.
LOG_CHANNEL_ID=

# How often to run the automatic check, in hours. Defaults to 24 (once a day) if left blank.
AUTO_CHECK_INTERVAL_HOURS=24

# ==================== LOA (Leave of Absence) system ====================

# Your Discord server's ID — needed so the /loa slash command shows up instantly.
# Right-click your server icon (Developer Mode on) > Copy Server ID.
GUILD_ID=

# Role ID(s) allowed to run /loa request — your Recording Crew roles.
# Separate multiple with commas.
RECORDING_CREW_ROLE_ID=

# Role ID(s) allowed to run /loa manage, /loa list, and click Approve/Deny — your staff/instructor roles.
# Separate multiple with commas.
LOA_STAFF_ROLE_ID=

# The role automatically given while someone's LOA is approved, and removed once it ends.
LOA_ROLE_ID=

# Where /loa request is used, and where public approved/denied announcements get posted.
LOA_CHANNEL_ID=

# Where the Approve/Deny embed gets posted for staff to act on.
LOA_STAFF_CHANNEL_ID=

# Where the bot pings staff when an LOA automatically ends. Defaults to LOA_STAFF_CHANNEL_ID if left blank.
LOA_LOG_CHANNEL_ID=

# The timezone LOA dates are interpreted in. Defaults to US Eastern if left blank.
LOA_TIMEZONE=America/New_York

# How often to check for expired LOAs, in hours. Defaults to 1 if left blank.
LOA_CHECK_INTERVAL_HOURS=1
